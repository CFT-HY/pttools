{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "additionalDirectories": [
      "../PTPlot"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)"
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "*.pydata.org",
        "*.readthedocs.io",
        "docs.h5py.org",
        "docs.pytest.org",
        "docs.scipy.org",
        "docs.sympy.org",
        "matplotlib.org",
        "numpy.org",
        "plotly.com"
      ]
    }
  }
}
